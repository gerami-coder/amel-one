# Browser-safe values from the Supabase project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Explicit trusted origin; set separately for each environment.
APP_URL=http://localhost:3000
APP_ENV=development
# Optional, migration tooling only. Never needed by the web runtime.
DATABASE_URL=
# Development seed/test harness only; never set in deployed applications.
SEED_EMAIL=
SEED_PASSWORD=
SEED_PROJECT_REF=
